# npm run dev automatically creates .env.local with independent random secrets.
# For deployment, generate two different secrets using the README command.
BETTER_AUTH_URL=http://localhost:3000
# Optional: exact additional origins for LAN access (comma-separated, no spaces).
# Used by authentication, API origin checks and Next.js dev resources.
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.10:3000
BETTER_AUTH_SECRET=
KEY_ENCRYPTION_SECRET=

# Optional: exact HTTPS gateway origins trusted by the server operator when
# a local proxy resolves domains to Fake-IP addresses (198.18.0.0/15).
# OpenAI and DeepSeek official origins already support this proxy mode.
# AI_PROXY_TRUSTED_ORIGINS=https://your-gateway.example.com

# Production: standard PostgreSQL. Never commit the real connection string.
# DATABASE_URL=postgresql://shiyi:YOUR_PASSWORD@localhost:5432/shiyi

# Development only: file-backed embedded PostgreSQL when DATABASE_URL is absent.
# LOCAL_DATABASE_PATH=.data/postgres
# Production single-process local preview only; cloud deployment should use PostgreSQL.
# ALLOW_LOCAL_DATABASE=true
