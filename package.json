{
  "name": "interview-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write src tests scripts deploy/*.mjs deploy/*.md *.ts *.mjs *.json *.yaml README.md",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "library:import": "tsx scripts/import-interview.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.23",
    "@electric-sql/pglite": "0.5.16",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "better-auth": "1.7.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "katex": "0.19.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "6.0.0",
    "undici": "7.30.2",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "katex": "$katex",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
